# What every board has in common. After this come the chip's own
# settings (sdkconfig.defaults.esp32s3, .esp32p4: ESP-IDF adds the one for
# the chip being built), then the board file, which has the last word.

# Every chip here reads its flash on four lines at 80 MHz; the size is
# the chip's or the board's (sdkconfig.defaults.<chip>, boards/).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Anything over a kilobyte goes to PSRAM unless it asks for internal
# memory by name (DMA buffers, task stacks). There are megabytes of PSRAM
# and a few hundred KB of internal RAM, so the default should lean the
# other way.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Static data in PSRAM where a variable asks for it (EXT_RAM_BSS_ATTR: the
# process table, the transfer, modem and alarm buffers), and lwIP's and
# the Wi-Fi driver's, which ESP-IDF moves by itself: about 30 KB of
# internal RAM. It needs the PSRAM there: QEMU is given 8 MB
# (tools/board.py), so it boots the same way.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# lwIP buffers: the network here carries a shell and the odd NTP packet,
# not bulk transfers, and every kilobyte is internal RAM. Measured: this
# frees about 12 KB and telnet still feels instant.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_MAX_SOCKETS=6

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# A process finds its struct proc in a thread-local pointer (pthreads have
# the first), and a parent waits on a notification its children give.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# 64-bit, so a process's CPU time in `ps` does not wrap after 71 minutes
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Processes run on core 1 and may hog it; only core 0's idle task is watched.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# The COM port is the console. The native USB port belongs to the keyboard.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Quiet ROM/bootloader/startup chatter: the kernel prints its own boot log.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Waking from suspend or poweroff is a whole boot, and the bootloader
# hashed all of the image again first, though nothing writes the flash
# while the chip sleeps: a power-on or a reset still checks it.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_COLORS=n

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_VFS_SUPPORT_DIR=y

# 460800 baud keeps the serial mirror from throttling screen output.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=460800
CONFIG_ESPTOOLPY_MONITOR_BAUD=460800

# Dynamic frequency scaling for the cpufreq policies (no light sleep).
CONFIG_PM_ENABLE=y

# FAT volumes: SD card, /tmp, and a FAT root filesystem or QEMU's RAM root.
CONFIG_FATFS_VOLUME_COUNT=4

# Idle light sleep (off by default, `power sleep on`) and the time-in-mode
# statistics `power` prints.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_PROFILING=y

# TLS for wget and curl: mbedTLS keeps its memory in PSRAM, since a
# handshake wants about 40 KB and internal RAM is where every process
# stack comes from. The certificate authorities browsers trust are built in
# (the default bundle); curl -k may go without checking, when told to.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Chains that end in a cross-signed root, as Cloudflare's do (GTS Root R4
# signed by GlobalSign): without this the bundle turns them away.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# And a certificate's dates are checked, which ESP-IDF leaves off by
# default: the clock is set whenever Wi-Fi connects and kept through power
# cuts (kernel/clock.c), so an expired certificate is refused, as a
# browser refuses it.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
