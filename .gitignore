# Build output: the firmware in build/<board>/, pico's PC tools in lang/build/
build/
build-*/
lang/build/

# Made from sdkconfig.defaults and the board file; those are the source
sdkconfig
sdkconfig.old

# Downloaded by the component manager (dependencies.lock pins the versions)
managed_components/

# Local clips made by `make video`
clips/

# Local downloads and converted clips from the video tools; keep the scripts.
/tools/*.mp4
/tools/*.webm
/tools/*.ptv
/tools/*.part

# Local service credentials, if used by host tools.
.env
.env.*
!.env.example

# Editor and tool caches
.cache/
__pycache__/
*.pyc
