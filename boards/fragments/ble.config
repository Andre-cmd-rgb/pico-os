# Bluetooth Low Energy, on a chip with its own radio (the ESP32-S3):
#
#	make BOARD=freenove-fnk0104b FRAGMENTS=ble defconfig
#
# The radio is started only when asked (`ble on`, `pad on`); built in,
# the code is about 330 KB of the image.
CONFIG_PT_BLE=y
CONFIG_PT_BLE_PAD=y

# The host stack is a Kconfig choice, so it has to be named here rather
# than selected: NimBLE, which is the smaller of the two.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# the HID part of NimBLE is its own switch, and the whole host-side file
# is compiled out without it: gamepads need it
CONFIG_BT_NIMBLE_HID_SERVICE=y

# One connection and two radio activities (a scan and that connection):
# measured, the defaults leave no internal RAM at all once the radio
# starts beside Wi-Fi.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# The host's own allocations can live in PSRAM, of which there are 8 MB.
# The controller's cannot: the radio reaches them from interrupts, and
# PSRAM is unreachable whenever the cache is off.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=8
