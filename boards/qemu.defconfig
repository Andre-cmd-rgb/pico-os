# QEMU: no display, no SD card, no keyboard but the console, and the root
# filesystem in RAM. QEMU emulates neither the flash filesystems nor octal
# PSRAM, so those are swapped out here.

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

CONFIG_PT_LCD_NONE=y
CONFIG_PT_SD_NONE=y
CONFIG_PT_ROOTFS_RAMDISK=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_PM_ENABLE=n
