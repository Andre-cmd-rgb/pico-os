# The ESP32-S3's own settings, after sdkconfig.defaults and before the
# board file.

# ESP32-S3 N16R8: 16 MB quad flash, 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The program runs from PSRAM: its code and constants are copied out of
# flash at boot, as Linux loads a program into RAM. Then a write to / no
# longer turns the cache off, which stopped every task whose code was not
# in IRAM until the flash had finished. Measured: a key typed while a file
# was copied to / took 32 ms to echo, and takes 1.3 ms now; reading / got
# 60% faster and deleting a file 40%. It costs the size of the program
# (2 MB) out of the 8 MB of PSRAM, and code is no faster from PSRAM than
# from flash: a shell loop and sed ran about 10% slower, the rest the same.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Two Wi-Fi memory settings were measured on the board and both left
# alone: SPIRAM_TRY_ALLOCATE_WIFI_LWIP cost 36 KB of internal RAM rather
# than saving any, and trimming the RX/TX buffer counts gained 2 KB,
# which is not worth the throughput it would cost.
#
# Code kept in IRAM comes out of the same internal SRAM as the heap. With
# Wi-Fi up and two terminals open, the heap was down to 26 KB: too little
# to start `curl | tr | head`. So the Wi-Fi driver's fast paths (27 KB)
# and the Bluetooth controller (20 KB) run from flash. The network here is
# a phone's hotspot, not a line that could use the extra speed, and the
# pad only needs a report every few milliseconds.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Larger CPU caches: faster PSRAM access and less flash-cache thrashing,
# for about 48 KB of internal RAM.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The low-power RISC-V core runs the keyboard watch during suspend.
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# Deep sleep keeps time on the RTC's slow clock. The 136 kHz RC drifts by
# percents with temperature; the 17.5 MHz one divided by 256 holds much
# better for about 5 uA more, and a longer calibration before each sleep
# measures it closer. kernel/clock.c learns what drift is left.
CONFIG_RTC_CLK_SRC_INT_8MD256=y
CONFIG_RTC_CLK_CAL_CYCLES=3000

# The battery's estimate of the current counts the time the chip spends
# in light sleep, which it learns from these.
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
