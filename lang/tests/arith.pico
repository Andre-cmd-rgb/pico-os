int main() {
    println(1 + 2 * 3 - 4 / 2, " ", (1 + 2) * 3, " ", 7 / 2, " ", -7 / 2, " ", 7 % 3, " ", -7 % 3);
    println(2147483647 + 1, " ", -2147483648 - 1, " ", 100000 * 100000, " ", -(-5));
    println(0x10, " ", 0b1011, " ", 'A', " ", '\n', " ", INT_MAX, " ", INT_MIN);
    float f = 10.0;
    println(f / 4.0, " ", f * 0.5, " ", f - 0.5, " ", 7.5 % 2.0, " ", -f);
    println(3 + 0.5, " ", 1 / 2, " ", 1.0 / 2, " ", float(1) / 2);
    int i = 10;
    i += 5; i -= 3; i *= 2; i /= 4; i %= 4;
    println(i);
    float g = 1.0;
    g += 1; g *= 2.5;
    println(g);
    return 0;
}
