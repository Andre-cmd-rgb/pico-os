// Concatenation appends in place when nobody else can see the string; every
// other holder of the same string must keep seeing it as it was.
struct Box { str s; }

str g = "glob";
str h = "";

str bang(str p) { p = p + "!"; return p; }
str twice(str p) { return p + p; }
str piece(int i) { return "<" + str(i) + ">"; }

int main() {
    // another variable
    str a = "x";
    str b = a;
    a = a + "y";
    println(a, " ", b);

    // a long one, past the pools, and its copy
    str long = "";
    for (int i = 0; i < 300; i++) { long = long + "z"; }
    str keep = long;
    long = long + "end";
    println(len(long), " ", len(keep), " ", ends_with(long, "end"), " ", ends_with(keep, "end"));

    // array elements, struct fields and globals that hold it
    str[] arr = [a];
    Box box = Box{s: a};
    h = a;
    a = a + "w";
    println(a, " ", arr[0], " ", box.s, " ", h);
    arr[0] = arr[0] + "1";
    box.s = box.s + "2";
    println(a, " ", arr[0], " ", box.s, " ", h);

    // pushed, then grown
    str[] seen = [];
    str s = "";
    for (int i = 0; i < 5; i++) {
        s = s + str(i);
        push(seen, s);
    }
    println(seen);

    // a global, with a local holding it too
    str hold = g;
    for (int i = 0; i < 3; i++) { g = g + "+"; }
    println(g, " ", hold);
    for (int i = 0; i < 200; i++) { g = g + "."; }
    println(len(g), " ", hold);

    // itself
    str t = "ab";
    t = t + t;
    t = t + t;
    println(t);

    // the variable read again before the store
    str u = "u";
    u = u + "-" + u;
    u = u + u + u;
    println(u);

    // a parameter: the caller's string stays
    str v = "call";
    println(bang(v), " ", v, " ", twice(v), " ", v);

    // temporaries in a chain
    str k = "key" + str(7) + "=" + str(8) + piece(9) + piece(10);
    println(k);
    str w = "";
    for (int i = 0; i < 12; i++) { w = w + str(i) + ","; }
    println(w);

    // the constant and the empty string stay as they were
    str c = "const";
    c = c + "ant";
    str e = "";
    e = e + "e";
    Box empty = Box{};
    empty.s = empty.s + "f";
    println(c, " const ", e, " [", Box{}.s, "] ", empty.s, " [", "", "]");

    // the items of a loop
    str[] items = ["p", "q"];
    for (str it in items) {
        it = it + "!";
        print(it, " ");
    }
    println(items);

    // a choice between two values
    str m = "m";
    for (int i = 0; i < 4; i++) { m = i % 2 == 0 ? m + "0" : "n" + m; }
    println(m);

    // more after the variable, before it is stored again
    str[] names = ["ann", "bob", "cy"];
    Box who = Box{s: "dee"};
    str out = "";
    for (int i = 0; i < 6; i++) {
        out = out + names[i % 3] + ": " + str(i * 7) + "/" + str(float(i) / 2.0) + who.s + "\n";
    }
    print(out);
    str keep2 = out;
    out = out + piece(1) + "!";
    println(len(out), " ", len(keep2));

    // ... reading the variable itself before the store
    str r = "r";
    for (int i = 0; i < 3; i++) { r = r + str(len(r)) + ","; }
    r = r + bang(r) + ".";
    r = r + str(len(r) * 2) + substr(r, 0, 1) + chr(r[1]);
    println(r);

    // ... where a built-in takes the joined string
    str sub = "abc";
    sub = substr(sub + "def", 2);
    sub = trim(sub + "  ") + "|";
    println(sub);

    // ... a global, with a function that reads it, or without
    for (int i = 0; i < 3; i++) { g = g + glen() + ";"; }
    for (int i = 0; i < 3; i++) { g = g + str(len(g)) + piece(i); }
    println(g);
    h = "";
    for (int i = 0; i < 4; i++) { h = h + chr(65 + i) + str(i); }
    println(h, " ", hold);

    // ... the result stored in another variable
    str src = "src";
    str dst = "";
    dst = src + "-" + "x";
    dst = src + str(1) + "y";
    println(src, " ", dst);
    return 0;
}

str glen() { return "(" + str(len(g)) + ")"; }
